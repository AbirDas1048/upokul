APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL=http://localhost:5173

OWNER_NAME="OWNER_NAME"
OWNER_DESIGNATION="Owner"
OWNER_EMAIL="OWNER_EMAIL"
OWNER_PHONE="+8801XXX-XXXXXX"

OFFICE_ADDRESS="OFFICE_ADDRESS"
OFFICE_PHONE="+8801XXX-XXXXXX"
OFFICE_EMAIL="OFFICE_EMAIL"

FACEBOOK_PAGE_LINK="FACEBOOK_PAGE_LINK"
FACEBOOK_PAGE_NAME="FACEBOOK_PAGE_NAME"
WHATSAPP_NUMBER="+8801XXX-XXXXXX"

# ── Security / anti-abuse (all optional; sensible defaults are built in) ─────────
# Behind nginx / Cloudflare / a load balancer, list the proxy IPs (or CIDRs) so the real visitor IP
# is used for rate limiting. Leave empty if the app is reached directly. Use * only if the app is
# reachable ONLY through your proxy (otherwise visitors could spoof their IP).
TRUSTED_PROXIES=

# Contact-form limits: per IP per minute / hour, per e-mail per hour, whole site per hour.
CONTACT_LIMIT_PER_MINUTE=3
CONTACT_LIMIT_PER_HOUR=10
CONTACT_LIMIT_PER_EMAIL_HOUR=3
CONTACT_LIMIT_GLOBAL_PER_HOUR=200
# Fastest a human can plausibly fill the form (seconds) and how long a loaded page stays valid (hours).
CONTACT_MIN_FILL_SECONDS=3
CONTACT_TOKEN_MAX_HOURS=6
# Max links allowed in the message (spam is mostly links).
CONTACT_MAX_LINKS=1

# Optional real bot challenge (free): https://dash.cloudflare.com/?to=/:account/turnstile
# Setting BOTH keys turns the widget on and makes the server verify it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# In production set: APP_ENV=production, APP_DEBUG=false, SESSION_SECURE_COOKIE=true (HTTPS only).
